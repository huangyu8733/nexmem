# 复制为 deploy/.env 后按需修改；docker compose -f deploy/docker-compose.yml 会自动加载。
# 服务端公网部署的最小配置：把 NEXMEM_PUBLIC_IP 改成服务器真实公网 IP 即可。

# 服务器公网 IP（不要用 127.0.0.1，否则其他节点拿到的地址无法拨号）
NEXMEM_PUBLIC_IP=1.2.3.4

# 对外端口；容器内固定监听 4001/4002，这里只改宿主机映射与对外宣告
NEXMEM_BOOTSTRAP_PORT=14001
NEXMEM_RELAY_PORT=14002
NEXMEM_DIRECTORY_PORT=8081

# 中继带宽限额：每节点每窗口允许转发的字节数（默认 1 GiB），<=0 表示不限
NEXMEM_RELAY_BANDWIDTH=1073741824
NEXMEM_RELAY_WINDOW=1h

# APNs 唤醒推送（可选，留空关闭）
# NEXMEM_APNS_KEY=/run/secrets/apns.p8
# NEXMEM_APNS_KEY_ID=
# NEXMEM_APNS_TEAM_ID=
# NEXMEM_APNS_BUNDLE_ID=
# NEXMEM_APNS_SANDBOX=0
