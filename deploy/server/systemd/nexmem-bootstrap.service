[Unit]
Description=Nexmem Bootstrap Node (private DHT)
Documentation=https://github.com/huangyu8733/nexmem
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexmem
Group=nexmem
EnvironmentFile=/etc/nexmem/server.env
ExecStart=/opt/nexmem/bin/nexmem-bootstrap \
  -listen /ip4/0.0.0.0/tcp/14001,/ip4/0.0.0.0/udp/14001/quic-v1 \
  -announce /ip4/${NEXMEM_PUBLIC_IP}/tcp/14001,/ip4/${NEXMEM_PUBLIC_IP}/udp/14001/quic-v1 \
  -id /var/lib/nexmem/bootstrap.key
Restart=unless-stopped
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexmem

[Install]
WantedBy=multi-user.target
