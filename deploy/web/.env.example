# 复制为 .env 后按需修改；docker compose 会自动加载。
# 对外域名，留空则为 localhost（Caddy 使用内置 CA 自签）。
NEXMEM_DOMAIN=chat.example.com

# 反向代理场景下如需跨域接入额外前端，可在此列出完整 Origin（逗号分隔）。
NEXMEM_WEB_ORIGINS=

# 浏览器端内核运行在 webd 进程内，以下网络配置在服务端统一注入（三端客户端共用同一套基础设施）。
# bootstrap / relay 的 PeerID 由服务端启动日志输出，详见 deploy/server/README.md。
NEXMEM_BOOTSTRAPS=/ip4/1.2.3.4/tcp/14001/p2p/12D3KooBOOTSTRAP_PEER_ID
NEXMEM_DIRECTORY_URL=http://1.2.3.4:8081
# 多个中继用逗号分隔；浏览器无法自行装配中继，必须在这里配置
NEXMEM_RELAY_ADDRS=/ip4/1.2.3.4/tcp/14002/p2p/12D3KooRELAY_PEER_ID
# 三种发现源（可与上面的自建基础设施并存）：
# 局域网 mDNS：同一 WiFi 下零服务器互联；只在同一网段用时，把上面公网地址全部留空即可
NEXMEM_MDNS=true
# 公共 DHT 兜底：无自建 bootstrap 时借公共 IPFS 网络寻址
NEXMEM_PUBLIC_DHT=false
# 手动导入的对端 multiaddr，逗号分隔（须含 /p2p/<PeerID>）
NEXMEM_MANUAL_ADDRS=
NEXMEM_DISPLAY_NAME=Nexmem Web
